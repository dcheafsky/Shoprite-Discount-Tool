{
  "manifest_version": 3,
  "name": "ShopRite Discount Tool",
  "version": "1.0",
  "description": "Helps visualize the discount on every ShopRite product and sorts results by discount across all pages, with department filtering.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://www.shoprite.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShopRite Discount Tool",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.shoprite.com/*"],
      "js": ["discount.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.shoprite.com/*"],
      "js": ["pageSize.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.shoprite.com/*"],
      "js": ["discount.js", "sortResults.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
